# Copy to .env and fill in. Never commit .env — it holds your secrets.
#   cp .env.example .env

# --- Required -------------------------------------------------------------

# Secret used to sign your login tokens. Any long random string; 32+ bytes.
# Generate one with:  openssl rand -base64 48
JWT_SIGNING_KEY=

# --- Optional -------------------------------------------------------------

# Image tag to run: the release you install, without its "v" (e.g. 1.2.0). With the updater on,
# Settings -> Updates changes this line for you. 'latest' pulls the newest release on every
# `docker compose pull`, but then the update check cannot tell which one you run.
PERSONAOS_VERSION=latest

# Host port for the web app.
PERSONAOS_PORT=8080

# Interface the web app binds to. Defaults to loopback, so the instance is
# reachable only from this machine — reach it from other devices over
# Tailscale, or put a reverse proxy with TLS in front. Setting this to 0.0.0.0
# exposes PersonaOS to your whole network (and possibly the internet) without
# TLS; only do that if you understand the consequences.
PERSONAOS_BIND=127.0.0.1

# Your AI provider API key is NOT set here — you enter it in the Setup Wizard and
# it is stored encrypted at rest in the database. (Keyless local models like
# Ollama need no key.)

# --- Voice (optional) -----------------------------------------------------
# Your own speech-to-text (faster-whisper) and text-to-speech (Kokoro) service on an NVIDIA GPU.
# Uncomment to start both with the stack (about 7 GB of image downloads, 1.6 GB model on first
# start, about 2 GB of video memory). Then set Settings -> Speech service to:
#   Address http://whisper:8000/v1 · speech-to-text model large-v3-turbo
#   text-to-speech model kokoro · voice af_heart
# Leave it off to use the phone's own speech, or OpenAI's (https://api.openai.com/v1 + your key).
# WHISPER_MODEL=large-v3-turbo

# --- Optional services ----------------------------------------------------
# Turn on any of these, comma-separated (no spaces):
#   speech   your own speech service (see Voice above)
#   ollama   the AI model on this machine; then Settings -> AI provider: Ollama,
#            address http://ollama:11434/v1, and once: docker compose exec ollama ollama pull qwen2.5:3b-instruct
#   updater  updates from the app: Settings -> Updates installs a release, or does it by itself
#            (Linux; needs PERSONAOS_DIR below)
# COMPOSE_PROFILES=speech,ollama,updater

# The folder with this .env and docker-compose.yml, as an absolute path. Only the updater uses it.
# PERSONAOS_DIR=/opt/personaos

# --- Off-host replication (optional) --------------------------------------
# Only used with the Litestream overlay:
#   docker compose -f docker-compose.yml -f docker-compose.litestream.yml up -d
# Continuously replicates personaos.db to an S3-compatible target. See docs/BACKUP.md.
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=            # e.g. https://s3.us-west-002.backblazeb2.com  (omit for AWS S3)
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
