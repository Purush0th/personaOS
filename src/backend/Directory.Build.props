<Project>
  <!--
    Build rules for every backend project (docs/ENGINEERING.md, C#). A warning fails the build;
    the .NET analyzers run at their recommended level, and the code style rules in .editorconfig
    that are set to warning are checked by the build, not only by the IDE.
  -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
</Project>
