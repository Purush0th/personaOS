# Editor and analyzer settings for the whole repository (docs/ENGINEERING.md).
root = true

[*]
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_size = 4
max_line_length = 140

# --- Code style checked by the build (EnforceCodeStyleInBuild) ---------------------------------
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning

# Private fields are _camelCase; most dependencies are primary-constructor parameters instead.
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# --- .NET analyzers (AnalysisLevel latest-recommended), with the rules turned off and why --------
# Logging through LoggerMessage source generators (CA1848, CA1873) buys speed this single-user
# server never needs, at the cost of a declaration per message; templates stay structured.
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none
# Identifiers that are keywords in Visual Basic (CA1716): nothing here is consumed from VB.
dotnet_diagnostic.CA1716.severity = none
# Concrete collection types on private members (CA1859): read-only interfaces say what a method
# promises; the devirtualisation it would buy does not matter at this scale.
dotnet_diagnostic.CA1859.severity = none

[**/Migrations/*.cs]
# Generated by EF; reviewed, not hand-edited.
generated_code = true

[src/backend/PersonaOS.Tests/**.cs]
# Test names are sentences with underscores (A_time_in_the_past_is_refused_before_the_card).
dotnet_diagnostic.CA1707.severity = none
# Test data spells out dates and numbers in the invariant form on purpose.
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1861.severity = none

[*.{dart,ts,js,json,yaml,yml,html,scss,css,md}]
indent_size = 2
