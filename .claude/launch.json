{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["ng", "serve", "--port", "4200"],
      "cwd": "src/frontend/PersonaOS.Dashboard",
      "port": 4200
    },
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--no-launch-profile"],
      "cwd": "src/backend/PersonaOS.Api",
      "env": {
        "ASPNETCORE_URLS": "http://localhost:5080",
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "port": 5080
    }
  ]
}
